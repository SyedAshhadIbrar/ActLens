# LLM Provider: openai | anthropic | gemini | ollama
LLM_PROVIDER=gemini
# Embeddings: hf (local, recommended) | openai | gemini | ollama
EMBEDDING_PROVIDER=hf

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Google Gemini (https://aistudio.google.com/apikey)
GOOGLE_API_KEY= 
GEMINI_MODEL=gemini-3.6-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Hugging Face embeddings (local sentence-transformers, no API key)
HF_EMBEDDING_MODEL=intfloat/multilingual-e5-small

# Ollama (local)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# Storage
CHROMA_PERSIST_DIR=./storage/chroma
BM25_INDEX_PATH=./storage/bm25/index.pkl
MANIFEST_PATH=./storage/manifest.json

# Data source: hf | files | both
DATA_SOURCE=hf
HF_DATASET_ID=jeroenherczeg/eu-ai-act
HF_DATASET_LANGUAGES=en,fr,nl
HF_DATASET_CACHE_DIR=./storage/hf_cache

# RAG settings
RETRIEVAL_TOP_K=20
RERANK_TOP_N=5
MAX_CONTEXT_TOKENS=3000
CHUNK_SIZE=512
CHUNK_OVERLAP=64

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# App
APP_NAME=ActLens
DEBUG=false
